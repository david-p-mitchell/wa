---
title: Thank You
layout: base.njk
---

<style>
  @import url('https://fonts.googleapis.com/css2?family=Lora:wght@600&family=DM+Sans:wght@400;500&display=swap');

  :root {
    --parchment: #faf7f2;
    --ink: #1c1814;
    --ink-muted: #6b6258;
    --accent: #8b3a1e;
  }

  html,
  body {
    margin: 0;
    min-height: 100vh;
    background: var(--parchment);
    color: var(--ink);
    font-family: 'DM Sans', sans-serif;
  }

  .thank-you {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
  }

  .thank-you h1 {
    font-family: 'Lora', serif;
    font-size: clamp(2rem, 5vw, 4rem);
    margin-bottom: 1rem;
    color: var(--accent);
  }

  .thank-you p {
    font-size: 1.2rem;
    color: var(--ink-muted);
    max-width: 40rem;
    margin: 0 auto;
  }
</style>

<div class="thank-you">
  <div>
    <h1>Thank You</h1>
    <p>
      Thanks for coming this week. We hope you've enjoyed it.
      We look forward to seeing you again soon.
    </p>
  </div>
</div>